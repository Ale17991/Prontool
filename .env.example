# Next.js
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Local: run `supabase start` and copy values from its output
# Production: from Supabase dashboard (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=PLACEHOLDER_http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_replace_with_service_role_key
SUPABASE_JWT_SECRET=PLACEHOLDER_replace_with_jwt_secret
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Patient data encryption (32-byte hex for pgcrypto symmetric encryption)
# Generate with: openssl rand -hex 32
PATIENT_DATA_ENCRYPTION_KEY=PLACEHOLDER_64_hex_chars

# Upstash QStash (create account at upstash.com → QStash)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=PLACEHOLDER_qstash_token
QSTASH_CURRENT_SIGNING_KEY=PLACEHOLDER_current_signing_key
QSTASH_NEXT_SIGNING_KEY=PLACEHOLDER_next_signing_key

# Resend (create account at resend.com, verify domain)
RESEND_API_KEY=PLACEHOLDER_resend_api_key
RESEND_FROM=alertas@dev.homio.com.br
# Remetente da redefinição de senha. Separado do RESEND_FROM de propósito: o
# padrão dos alertas aponta para o domínio de dev, e e-mail de senha saindo de
# `dev.` treina o usuário a ignorar aviso de segurança. O DOMÍNIO precisa estar
# verificado no Resend — sem isso o envio falha com 403.
RESEND_FROM_NOREPLY=nao-responda@clinnipro.com.br

# GHL (per-tenant secret is stored encrypted in tenant_ghl_config)
# This is only the dev fallback used by the local simulator script.
GHL_DEV_WEBHOOK_SECRET=dev-shared-secret

# GoHighLevel Marketplace OAuth 2.0 (feature 008)
# Created at https://marketplace.gohighlevel.com → My Apps → New App.
# REDIRECT_URI must match exactly the value registered in the app config.
# SCOPES is comma-separated; check spec.md FR-002 / quickstart.md for the
# required set. Read ONLY by src/lib/integrations/ghl/oauth/env.ts.
GHL_CLIENT_ID=PLACEHOLDER_ghl_marketplace_client_id
GHL_CLIENT_SECRET=PLACEHOLDER_ghl_marketplace_client_secret
GHL_REDIRECT_URI=http://localhost:3000/api/oauth/ghl/callback
GHL_SCOPES=contacts.readonly,contacts.write,custom-fields.readonly,custom-fields.write,locations.readonly,opportunities.write,webhooks.readonly,webhooks.write

# HMAC shared secret for INSTALL/UNINSTALL marketplace webhooks (one per app,
# not per tenant). See research.md item 3 — header name and algorithm may need
# verification against current GHL Marketplace docs before launch.
GHL_MARKETPLACE_SHARED_SECRET=PLACEHOLDER_marketplace_hmac_secret

# JWKS URL for verifying SSO context tokens (US5). Public endpoint — no secret.
# Used only when /api/sso/ghl is exercised; safe to leave as default in dev.
GHL_SSO_JWKS_URL=https://services.leadconnectorhq.com/.well-known/jwks.json

# Google Calendar — agenda pessoal do profissional (migrations 0124/0125)
# Criado em https://console.cloud.google.com → APIs e Serviços → Credenciais →
# Criar credenciais → ID do cliente OAuth → Tipo "Aplicativo da Web".
# Exige a Google Calendar API HABILITADA no projeto e, na tela de consentimento,
# os escopos calendar.events (sensível — pede verificação em produção) e
# userinfo.email (para exibir a conta conectada).
# REDIRECT_URI tem que ser IDÊNTICO ao registrado no Google Cloud, senão o
# callback volta com redirect_uri_mismatch. Em produção use o domínio real:
#   https://app.clinnipro.com.br/api/oauth/google-calendar/callback
# Lido APENAS por src/lib/integrations/google-calendar/oauth/env.ts.
# ATENÇÃO: além destas três, o fluxo exige SUPABASE_JWT_SECRET (acima) — é ela
# que assina o cookie de state do OAuth. Sem qualquer uma das QUATRO, o card
# "Agenda Google" no cadastro do profissional aparece como "não configurado" e o
# código fica inerte (não quebra).
GOOGLE_CLIENT_ID=PLACEHOLDER_google_oauth_client_id
GOOGLE_CLIENT_SECRET=PLACEHOLDER_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google-calendar/callback

# Platform operator (for LGPD anonymize endpoint and TUSS seed admin ops)
PLATFORM_OPERATOR_TOKEN=PLACEHOLDER_random_long_secret

# Cloudflare Turnstile — captcha invisible, LGPD-friendly, sem cookies (feature 017)
# Gere no painel Cloudflare: https://dash.cloudflare.com → Turnstile → Add Site
# Em dev local, use sitekeys de teste públicas da Cloudflare:
#   1x00000000000000000000AA = sempre passa (use por padrao em dev)
#   2x00000000000000000000AB = sempre falha (UX de erro)
#   3x00000000000000000000FF = sempre renderiza challenge (UX de desafio visivel)
# Secrets correspondentes em dev:
#   1x0000000000000000000000000000000AA / 2x... / 3x...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Vercel Cron (feature 018 — motor de lembretes)
# Compartilhe entre vercel.json e o handler /api/cron/send-reminders.
# Gere com: openssl rand -base64 32
CRON_SECRET=PLACEHOLDER_dev_secret

# Observability
LOG_LEVEL=info

# Feature flags (telas em desenvolvimento — visíveis em dev, ocultas em prod)
# Default: true em dev/test, false em prod (controlado por NODE_ENV em
# src/lib/feature-flags.ts). Setar explicitamente "true" / "false" pra
# forçar o estado em qualquer ambiente.
NEXT_PUBLIC_FEATURE_DESPESAS=false
NEXT_PUBLIC_FEATURE_ANAMNESE=false
NEXT_PUBLIC_FEATURE_RELATORIOS=false
NEXT_PUBLIC_FEATURE_COMISSOES=false

# Portal do paciente (feature 030) — assina o cookie HMAC de sessao do paciente.
# Gerar com: openssl rand -hex 32. Segredo dedicado (nao reusar SUPABASE_JWT_SECRET).
PATIENT_SESSION_SECRET=PLACEHOLDER_64_hex_chars

# WhatsApp — serviço de envio (feature 051)
# O envio de lembretes por WhatsApp passa por um serviço separado (repo
# Homio-CRM/clinni-whatsapp), que fala com a Evolution API.
WHATSAPP_SERVICE_URL=https://SEU_PROJETO_WHATSAPP.supabase.co/functions/v1
# Chave MESTRA de plataforma — provisiona a clínica no serviço e devolve a
# api_key dela. NÃO é credencial de tenant: a api_key de cada clínica é
# guardada CIFRADA em tenant_whatsapp_config.api_key_enc, nunca em env.
# Lida apenas em código de servidor sob requireRole('admin').
WHATSAPP_SERVICE_MASTER_KEY=PLACEHOLDER_master_key

# ---------------------------------------------------------------------------
# Asaas — cobrança da assinatura da Clinni (o que NÓS recebemos das clínicas)
#
# Não confundir com o financeiro da clínica (o que os pacientes pagam a ela):
# aquele não usa estas variáveis. A chave abaixo é da conta Asaas da Clinni.
# ---------------------------------------------------------------------------
# 'sandbox' (padrão) ou 'production'. Só mude junto com a chave correspondente:
# chave de produção em ambiente sandbox emite cobrança de verdade.
ASAAS_ENV=sandbox
# Chave da conta Asaas da plataforma (Configurações → Integrações → API).
ASAAS_API_KEY=PLACEHOLDER_asaas_api_key
# Token que o Asaas envia no header `asaas-access-token` de cada webhook. Você
# define este valor ao cadastrar o webhook no painel deles. SEM ele a rota
# /api/webhooks/asaas responde 503 e nenhum pagamento libera acesso.
ASAAS_WEBHOOK_TOKEN=PLACEHOLDER_asaas_webhook_token
# Opcional — sobrescreve a URL base da API. Existe porque o Asaas já trocou o
# host do sandbox uma vez, e trocar host não pode exigir deploy de código.
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# ---------------------------------------------------------------------------
# CRM da Homio (GoHighLevel) — tickets de suporte viram contato no NOSSO CRM
#
# NÃO confundir com GHL_CLIENT_ID/SECRET acima, que são do app do Marketplace
# instalado na conta de CADA CLÍNICA. Estes apontam para uma location da
# Homio: destino fixo, nosso, fora do event bus por tenant. Sem eles o envio
# é simplesmente pulado — o ticket continua salvo e o e-mail continua saindo.
# ---------------------------------------------------------------------------
# Private Integration Token da location da Homio (Settings → Private Integrations).
# Escopos necessários: contacts.readonly, contacts.write, locations/customFields.readonly
GHL_HOMIO_TOKEN=PLACEHOLDER_private_integration_token
# Id da location (sub-conta) da Homio que recebe os contatos.
GHL_HOMIO_LOCATION_ID=PLACEHOLDER_location_id
